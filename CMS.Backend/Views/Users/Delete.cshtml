@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Xóa Người dùng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold text-danger mb-0">Xóa Người dùng</h2>
    <p class="text-muted">Bạn có chắc chắn muốn xóa tài khoản này không? Hành động này không thể hoàn tác.</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card border border-danger shadow-sm bg-white p-4">
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Cảnh báo!</strong> Tài khoản này sẽ bị xóa vĩnh viễn khỏi cơ sở dữ liệu.
            </div>

            <div class="row mb-3">
                <div class="col-4 detail-label">ID</div>
                <div class="col-8 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Tên đăng nhập</div>
                <div class="col-8 detail-value">@Model.Username</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Họ và tên</div>
                <div class="col-8 detail-value">@Model.FullName</div>
            </div>
            <div class="row mb-4">
                <div class="col-4 detail-label">Vai trò</div>
                <div class="col-8 detail-value">
                    <span class="badge bg-secondary p-2">@Model.Role</span>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-fill py-2">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-light border flex-fill py-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
