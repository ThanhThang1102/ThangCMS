@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Cập nhật Người dùng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Cập nhật Người dùng</h2>
    <p class="text-muted">Chỉnh sửa thông tin tài khoản #@Model.Id</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card border border-light shadow-sm p-4 bg-white">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-medium">Tên đăng nhập</label>
                    <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập..." required />
                    <span asp-validation-for="Username" class="text-danger fs-7"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordHash" class="form-label fw-medium">Mật khẩu (Mới/Giữ nguyên)</label>
                    <input asp-for="PasswordHash" type="text" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu..." />
                    <span asp-validation-for="PasswordHash" class="text-danger fs-7"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-medium">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." required />
                    <span asp-validation-for="FullName" class="text-danger fs-7"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label fw-medium">Vai trò</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Quản trị viên">Quản trị viên</option>
                        <option value="Biên tập viên">Biên tập viên</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger fs-7"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
