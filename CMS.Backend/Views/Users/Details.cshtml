@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Chi tiết Người dùng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Chi tiết Người dùng</h2>
    <p class="text-muted">Thông tin tài khoản #@Model.Id</p>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border border-light shadow-sm bg-white p-4">
            <div class="row mb-3">
                <div class="col-4 detail-label">ID</div>
                <div class="col-8 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Tên đăng nhập</div>
                <div class="col-8 detail-value">@Model.Username</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Mật khẩu</div>
                <div class="col-8 detail-value">
                    <span class="font-monospace">@Model.PasswordHash</span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Họ và tên</div>
                <div class="col-8 detail-value">@Model.FullName</div>
            </div>
            <div class="row mb-4">
                <div class="col-4 detail-label">Vai trò</div>
                <div class="col-8 detail-value">
                    @{
                        string roleBadge = Model.Role switch
                        {
                            "Quản trị viên" => "bg-danger bg-opacity-10 text-danger",
                            "Biên tập viên" => "bg-success bg-opacity-10 text-success",
                            _ => "bg-secondary bg-opacity-10 text-secondary"
                        };
                    }
                    <span class="badge @roleBadge p-2">@Model.Role</span>
                </div>
            </div>
            
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill">
                    <i class="bi bi-trash me-1"></i> Xóa tài khoản
                </a>
            </div>
        </div>
    </div>
</div>
