@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Chi tiết Danh mục bài viết";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Chi tiết Danh mục bài viết</h2>
    <p class="text-muted">Thông tin danh mục #@Model.Id</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card border border-light shadow-sm bg-white p-4">
            <div class="row mb-3">
                <div class="col-4 detail-label">ID</div>
                <div class="col-8 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Tên danh mục</div>
                <div class="col-8 detail-value">@Model.Name</div>
            </div>
            <div class="row mb-4">
                <div class="col-4 detail-label">Mô tả</div>
                <div class="col-8 detail-value">@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)</div>
            </div>
            
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill">
                    <i class="bi bi-trash me-1"></i> Xóa danh mục
                </a>
            </div>
        </div>
    </div>
</div>
