@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Chi tiết sản phẩm</h2>
    <p class="text-muted">Thông tin sản phẩm #@Model.Id</p>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border border-light shadow-sm bg-white p-4 mb-4">
            <div class="row">
                <div class="col-md-5 mb-4 mb-md-0 text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="rounded border img-fluid w-100" style="max-height: 320px; object-fit: cover;" alt="Product Image" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted w-100" style="height: 250px;">
                            <span>Không có hình ảnh</span>
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    <h3 class="fw-bold text-dark mb-1">@Model.Name</h3>
                    <p class="badge bg-light text-dark border p-2 mb-3">Danh mục: @Model.CategoryProduct?.Name</p>
                    
                    <div class="fs-4 fw-bold text-indigo mb-3">
                        @Model.Price.ToString("N0") <span class="fs-6">đ</span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4 detail-label">Tồn kho</div>
                        <div class="col-8 detail-value fw-semibold @(Model.StockQuantity == 0 ? "text-danger" : "text-dark")">
                            @(Model.StockQuantity == 0 ? "Hết hàng" : $"{Model.StockQuantity} sản phẩm")
                        </div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <h6 class="fw-semibold text-muted mb-2">MÔ TẢ SẢN PHẨM</h6>
                        <div class="text-dark lh-base" style="white-space: pre-line;">
                            @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả cho sản phẩm này." : Model.Description)
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-fill">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill">
                            <i class="bi bi-trash me-1"></i> Xóa sản phẩm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
