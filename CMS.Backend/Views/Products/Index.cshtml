@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Quản lý Sản phẩm</h2>
        <p class="text-muted mb-0">Danh sách các sản phẩm đang kinh doanh trên hệ thống cửa hàng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
    </a>
</div>

<div class="card border border-light shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th style="width: 80px;">Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string stockClass = item.StockQuantity switch
                        {
                            0 => "text-danger fw-bold",
                            _ when item.StockQuantity < 10 => "text-warning fw-semibold",
                            _ => "text-muted"
                        };
                        string stockText = item.StockQuantity == 0 ? "Hết hàng" : item.StockQuantity.ToString();

                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" alt="Product" />
                                }
                                else
                                {
                                    <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px; font-size: 0.65rem;">No Image</div>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@item.Name</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border p-2">@item.CategoryProduct?.Name</span>
                            </td>
                            <td class="fw-medium text-indigo">@item.Price.ToString("N0") <span class="fs-7">đ</span></td>
                            <td class="@stockClass">@stockText</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary me-1">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-info me-1">
                                    <i class="bi bi-info-circle"></i> Chi tiết
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
