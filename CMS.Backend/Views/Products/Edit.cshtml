@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Cập nhật sản phẩm</h2>
    <p class="text-muted">Chỉnh sửa thông tin sản phẩm #@Model.Id</p>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border border-light shadow-sm p-4 bg-white mb-4">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-medium">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." required />
                    <span asp-validation-for="Name" class="text-danger fs-7"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryProductId" class="form-label fw-medium">Danh mục sản phẩm</label>
                        <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductId"></select>
                        <span asp-validation-for="CategoryProductId" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Hình ảnh sản phẩm</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Chọn ảnh mới để thay đổi.</small>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label fw-medium d-block">Ảnh sản phẩm hiện tại</label>
                        <img src="@Model.ImageUrl" class="rounded border img-thumbnail" style="max-height: 120px; object-fit: cover;" alt="Current Image" />
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-medium">Giá bán (VNĐ)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Nhập giá bán..." required />
                        <span asp-validation-for="Price" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label fw-medium">Số lượng tồn kho</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="Nhập số lượng tồn..." required />
                        <span asp-validation-for="StockQuantity" class="text-danger fs-7"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-medium">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Mô tả sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="text-danger fs-7"></span>
                </div>

                <button type="submit" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
