@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Xóa bài viết";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold text-danger mb-0">Xóa bài viết</h2>
    <p class="text-muted">Bạn có chắc chắn muốn xóa bài viết này không? Hành động này sẽ xóa dữ liệu vĩnh viễn.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border border-danger shadow-sm bg-white p-4">
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Cảnh báo!</strong> Bài viết này sẽ bị xóa khỏi hệ thống, các tập tin ảnh liên quan cũng có thể bị gỡ bỏ.
            </div>

            <div class="row mb-3">
                <div class="col-3 detail-label">ID</div>
                <div class="col-9 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-3 detail-label">Tiêu đề</div>
                <div class="col-9 detail-value fw-semibold text-dark">@Model.Title</div>
            </div>
            <div class="row mb-3">
                <div class="col-3 detail-label">Danh mục</div>
                <div class="col-9 detail-value">@Model.Category?.Name</div>
            </div>
            <div class="row mb-4">
                <div class="col-3 detail-label">Ngày tạo</div>
                <div class="col-9 detail-value">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-fill py-2">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-light border flex-fill py-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
