@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Chi tiết bài viết</h2>
    <p class="text-muted">Thông tin bài viết #@Model.Id</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border border-light shadow-sm bg-white p-4 mb-4">
            <h3 class="fw-bold text-dark mb-2">@Model.Title</h3>
            
            <div class="d-flex align-items-center text-muted mb-4 fs-7 gap-3">
                <span><i class="bi bi-folder2-open me-1"></i> Danh mục: <strong class="text-dark">@Model.Category?.Name</strong></span>
                <span>|</span>
                <span><i class="bi bi-clock me-1"></i> Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-4 text-center">
                    <img src="@Model.ImageUrl" class="rounded border img-fluid" style="max-height: 400px; object-fit: cover;" alt="Post Image" />
                </div>
            }

            <hr />

            <div class="post-content lh-lg text-dark my-4" style="white-space: pre-line;">
                @Model.Content
            </div>

            <hr />
            
            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa bài viết
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill">
                    <i class="bi bi-trash me-1"></i> Xóa bài viết
                </a>
            </div>
        </div>
    </div>
</div>
