@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Viết bài mới";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Viết bài mới</h2>
    <p class="text-muted">Nhập nội dung bài viết và lựa chọn danh mục phù hợp</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border border-light shadow-sm p-4 bg-white mb-4">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-medium">Tiêu đề bài viết</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề hấp dẫn..." required />
                    <span asp-validation-for="Title" class="text-danger fs-7"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-medium">Danh mục bài viết</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger fs-7"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Hình ảnh đại diện</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Hỗ trợ định dạng jpg, jpeg, png.</small>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-medium">Nội dung chi tiết</label>
                    <textarea asp-for="Content" class="form-control" rows="12" placeholder="Viết nội dung bài viết tại đây..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger fs-7"></span>
                </div>

                <button type="submit" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-check-circle me-1"></i> Xuất bản bài viết
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
