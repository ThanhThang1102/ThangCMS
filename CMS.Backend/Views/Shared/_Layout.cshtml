<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThangCMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-grid-1x2-fill me-2 text-primary"></i>
                <span>ThangCMS</span>
            </div>
            
            <div class="sidebar-user">
                <div class="user-avatar">
                    <i class="bi bi-person-circle fs-3 text-secondary"></i>
                </div>
                <div class="user-info">
                    <span class="user-name">@(User.Identity.IsAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name : "Khách")</span>
                    <span class="user-role">@(User.Identity.IsAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value : "")</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <span class="nav-section-title">Tổng quan</span>
                <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Advertisements" ? "active" : "")" asp-controller="Advertisements" asp-action="Index">
                    <i class="bi bi-images"></i>
                    <span>Quản lý Banner (Ads)</span>
                </a>

                <span class="nav-section-title">Blog & Tin tức</span>
                <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-folder2-open"></i>
                    <span>Danh mục tin</span>
                </a>
                <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posts" ? "active" : "")" asp-controller="Posts" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Bài viết</span>
                </a>

                <span class="nav-section-title">Bán hàng (E-commerce)</span>
                <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoriesProducts" ? "active" : "")" asp-controller="CategoriesProducts" asp-action="Index">
                    <i class="bi bi-tags"></i>
                    <span>Danh mục sản phẩm</span>
                </a>
                <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>
                @if (User.IsInRole("Quản trị viên") || User.IsInRole("Admin"))
                {
                    <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Khách hàng</span>
                    </a>
                    <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-cart3"></i>
                        <span>Đơn hàng</span>
                    </a>

                    <span class="nav-section-title">Hệ thống</span>
                    <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-shield-lock"></i>
                        <span>Người dùng</span>
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top Navbar -->
            <header class="app-header">
                <div class="header-search">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-0" placeholder="Tìm kiếm nhanh...">
                    </div>
                </div>
                <div class="header-actions">
                    <div class="header-btn position-relative">
                        <i class="bi bi-bell fs-5 text-secondary"></i>
                        <span class="position-absolute top-2 start-75 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                    </div>
                    <div class="vertical-divider mx-3"></div>
                    <div class="header-profile">
                        <span class="me-2 d-none d-md-inline text-muted">Xin chào, <strong>@(User.Identity.IsAuthenticated ? User.Identity.Name : "Khách")</strong></span>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">Đăng nhập</a>
                        }
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="app-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer text-muted">
                <span>&copy; @DateTime.Now.Year - ThangCMS Backend Panel. Designed with <i class="bi bi-heart-fill text-danger fs-6"></i>.</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
