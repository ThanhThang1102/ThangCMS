@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Cập nhật Danh mục sản phẩm";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Cập nhật Danh mục sản phẩm</h2>
    <p class="text-muted">Chỉnh sửa thông tin danh mục #@Model.Id</p>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border border-light shadow-sm p-4 bg-white">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-medium">Tên danh mục sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." required />
                    <span asp-validation-for="Name" class="text-danger fs-7"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-medium">Mô tả danh mục</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả danh mục..."></textarea>
                    <span asp-validation-for="Description" class="text-danger fs-7"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
