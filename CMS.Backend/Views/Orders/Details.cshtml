@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Id}";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Chi tiết Đơn hàng #@Model.Id</h2>
    <p class="text-muted">Thông tin tổng quan và danh sách sản phẩm đặt mua</p>
</div>

<div class="row">
    <!-- Order info -->
    <div class="col-lg-4 mb-4">
        <div class="card border border-light shadow-sm bg-white p-4 h-100">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin chung</h5>
            
            <div class="mb-3">
                <div class="detail-label">Mã đơn hàng</div>
                <div class="detail-value fw-semibold text-dark">#@Model.Id</div>
            </div>

            <div class="mb-3">
                <div class="detail-label">Ngày đặt</div>
                <div class="detail-value text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="mb-3">
                <div class="detail-label">Trạng thái</div>
                <div class="detail-value mt-1">
                    @{
                        string statusText = Model.Status switch
                        {
                            0 => "Chờ duyệt",
                            1 => "Đang giao",
                            2 => "Đã xong",
                            _ => "Không rõ"
                        };
                        string statusClass = Model.Status switch
                        {
                            0 => "badge-status-pending",
                            1 => "badge-status-shipping",
                            2 => "badge-status-completed",
                            _ => "bg-secondary text-white"
                        };
                    }
                    <span class="badge-status @statusClass">@statusText</span>
                </div>
            </div>

            <div class="mb-4">
                <div class="detail-label">Ghi chú từ quản lý</div>
                <div class="detail-value text-muted italic">
                    @(string.IsNullOrEmpty(Model.Notes) ? "(Không có ghi chú)" : Model.Notes)
                </div>
            </div>

            <h5 class="fw-bold mb-3 border-bottom pb-2">Khách hàng đặt mua</h5>
            
            <div class="mb-3">
                <div class="detail-label">Họ và tên</div>
                <div class="detail-value text-dark">@Model.Customer?.FullName</div>
            </div>

            <div class="mb-3">
                <div class="detail-label">Email</div>
                <div class="detail-value text-dark">@Model.Customer?.Email</div>
            </div>

            <div class="mb-3">
                <div class="detail-label">Số điện thoại</div>
                <div class="detail-value text-dark">@(string.IsNullOrEmpty(Model.Customer?.Phone) ? "Chưa cung cấp" : Model.Customer?.Phone)</div>
            </div>

            <div class="mb-0">
                <div class="detail-label">Địa chỉ nhận hàng</div>
                <div class="detail-value text-dark text-wrap">@(string.IsNullOrEmpty(Model.Customer?.Address) ? "Chưa cung cấp" : Model.Customer?.Address)</div>
            </div>
            
            <div class="mt-4 border-top pt-3 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i> Xử lý đơn hàng
                </a>
            </div>
        </div>
    </div>

    <!-- Product list (Order Details) -->
    <div class="col-lg-8 mb-4">
        <div class="card border border-light shadow-sm bg-white h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0">Danh sách sản phẩm trong đơn</h5>
            </div>
            
            <div class="table-responsive flex-grow-1">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails == null || !Model.OrderDetails.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Đơn hàng này không chứa sản phẩm nào.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var detail in Model.OrderDetails)
                            {
                                decimal subtotal = detail.Quantity * detail.UnitPrice;
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(detail.Product?.ImageUrl))
                                        {
                                            <img src="@detail.Product.ImageUrl" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" alt="Product" />
                                        }
                                        else
                                        {
                                            <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px; font-size: 0.65rem;">No Image</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@detail.Product?.Name</span>
                                        <small class="text-muted d-block">Mã sản phẩm: #@detail.ProductId</small>
                                    </td>
                                    <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center fw-medium">@detail.Quantity</td>
                                    <td class="text-end fw-semibold text-dark">@subtotal.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-light border-0 p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-5 fw-bold text-dark">TỔNG TIỀN ĐƠN HÀNG:</span>
                    <span class="fs-4 fw-bold text-indigo">@(((decimal)ViewBag.TotalOrderValue).ToString("N0")) đ</span>
                </div>
            </div>
        </div>
    </div>
</div>
