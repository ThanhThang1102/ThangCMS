@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Xóa đơn hàng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold text-danger mb-0">Xóa đơn hàng</h2>
    <p class="text-muted">Bạn có chắc chắn muốn xóa đơn hàng này? Toàn bộ chi tiết đơn hàng (các mặt hàng) cũng sẽ bị xóa vĩnh viễn.</p>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border border-danger shadow-sm bg-white p-4">
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Cảnh báo!</strong> Thao tác xóa đơn hàng này sẽ xóa sạch dòng chi tiết đơn hàng. Vui lòng cân nhắc kỹ trước khi xóa.
            </div>

            <div class="row mb-3">
                <div class="col-4 detail-label">Mã đơn hàng</div>
                <div class="col-8 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Khách hàng</div>
                <div class="col-8 detail-value fw-semibold text-dark">@Model.Customer?.FullName</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Ngày đặt</div>
                <div class="col-8 detail-value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="row mb-4">
                <div class="col-4 detail-label">Trạng thái</div>
                <div class="col-8 detail-value">
                    @{
                        string statusText = Model.Status switch
                        {
                            0 => "Chờ duyệt",
                            1 => "Đang giao",
                            2 => "Đã xong",
                            _ => "Không rõ"
                        };
                    }
                    <span class="badge bg-secondary text-white p-2">@statusText</span>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-fill py-2">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-light border flex-fill py-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
