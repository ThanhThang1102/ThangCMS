@model IEnumerable<CMS.Data.Entities.Advertisement>

@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-gray-800">Quản lý Banner Quảng cáo</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Thêm Banner mới
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th width="80">Ảnh</th>
                        <th>Tiêu đề</th>
                        <th>Link Đích</th>
                        <th width="100">Thứ tự</th>
                        <th width="120">Trạng thái</th>
                        <th width="150" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="img-thumbnail" style="max-height: 50px; max-width: 100px; object-fit: contain;" />
                            }
                        </td>
                        <td class="fw-bold">@item.Title</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.TargetLink))
                            {
                                <a href="@item.TargetLink" target="_blank" class="text-truncate d-inline-block" style="max-width: 150px;">@item.TargetLink</a>
                            }
                        </td>
                        <td class="text-center">@item.DisplayOrder</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Đang hiện</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đang ẩn</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
