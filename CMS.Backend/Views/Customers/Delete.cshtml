@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Xóa Khách hàng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold text-danger mb-0">Xóa Khách hàng</h2>
    <p class="text-muted">Bạn có chắc chắn muốn xóa khách hàng này? Tất cả các thông tin lịch sử mua hàng có thể bị lỗi liên kết.</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card border border-danger shadow-sm bg-white p-4">
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Cảnh báo!</strong> Khi xóa khách hàng này, hồ sơ khách hàng sẽ bị gỡ bỏ vĩnh viễn khỏi cơ sở dữ liệu.
            </div>

            <div class="row mb-3">
                <div class="col-4 detail-label">ID</div>
                <div class="col-8 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Họ tên</div>
                <div class="col-8 detail-value">@Model.FullName</div>
            </div>
            <div class="row mb-4">
                <div class="col-4 detail-label">Email</div>
                <div class="col-8 detail-value text-muted">@Model.Email</div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger flex-fill py-2">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-light border flex-fill py-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
