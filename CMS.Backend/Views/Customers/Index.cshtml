@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Quản lý Khách hàng</h2>
        <p class="text-muted mb-0">Danh sách khách hàng đã đăng ký mua hàng trên hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm khách hàng mới
    </a>
</div>

<div class="card border border-light shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Điện thoại</th>
                    <th>Địa chỉ</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa có khách hàng nào đăng ký.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td class="fw-semibold">@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@(string.IsNullOrEmpty(item.Phone) ? "Chưa cung cấp" : item.Phone)</td>
                            <td class="text-muted text-truncate" style="max-width: 250px;">@(string.IsNullOrEmpty(item.Address) ? "Chưa cung cấp" : item.Address)</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary me-1">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-info me-1">
                                    <i class="bi bi-info-circle"></i> Chi tiết
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
