@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Chi tiết Khách hàng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light border mb-2">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mb-0">Chi tiết Khách hàng</h2>
    <p class="text-muted">Thông tin hồ sơ khách hàng #@Model.Id</p>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border border-light shadow-sm bg-white p-4">
            <div class="row mb-3">
                <div class="col-4 detail-label">ID</div>
                <div class="col-8 detail-value">#@Model.Id</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Họ và tên</div>
                <div class="col-8 detail-value">@Model.FullName</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Email</div>
                <div class="col-8 detail-value">@Model.Email</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Điện thoại</div>
                <div class="col-8 detail-value">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cung cấp" : Model.Phone)</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 detail-label">Mật khẩu thô</div>
                <div class="col-8 detail-value"><code>@Model.Password</code></div>
            </div>
            <div class="row mb-4">
                <div class="col-4 detail-label">Địa chỉ</div>
                <div class="col-8 detail-value">@(string.IsNullOrEmpty(Model.Address) ? "Chưa cung cấp" : Model.Address)</div>
            </div>
            
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill">
                    <i class="bi bi-trash me-1"></i> Xóa khách hàng
                </a>
            </div>
        </div>
    </div>
</div>
